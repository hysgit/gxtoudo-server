FROM python:3.11-slim-bullseye
RUN sed -i 's|^deb http://deb.debian.org/debian-security |deb [check-valid-until=no] https://archive.debian.org/debian-security |; s|^deb http://deb.debian.org/debian |deb https://deb.debian.org/debian |' /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk ca-certificates unzip libatomic1 \
      libasound2 libatk1.0-0 libatk-bridge2.0-0 libcairo2 libcups2 libdbus-1-3 libdrm2 \
      libgbm1 libglib2.0-0 libnss3 libnspr4 libpango-1.0-0 libx11-6 libxcb1 \
      libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
    && rm -rf /var/lib/apt/lists/*
ARG CHROME_VERSION=158.0.8127.36
RUN pip install --no-cache-dir playwright==1.65.2 \
    && python -c "from urllib.request import urlretrieve; urlretrieve('https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/linux64/chrome-headless-shell-linux64.zip', '/tmp/chrome.zip')" \
    && unzip -q /tmp/chrome.zip -d /opt \
    && rm /tmp/chrome.zip \
    && /opt/chrome-headless-shell-linux64/chrome-headless-shell --version \
    && groupadd --gid 10001 browser \
    && useradd --uid 10001 --gid 10001 --home-dir /data --no-create-home browser \
    && install -d -m 0700 -o 10001 -g 10001 /data
ENV CHROMIUM=/opt/chrome-headless-shell-linux64/chrome-headless-shell HOME=/data PYTHONUNBUFFERED=1
COPY deploy/price-browser.py deploy/price-collector.py deploy/price_cart.py /app/
USER 10001:10001
EXPOSE 8790
ENTRYPOINT ["python", "/app/price-browser.py"]
